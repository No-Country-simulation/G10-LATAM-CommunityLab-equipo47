# Copia este archivo a .env y rellena tus valores. Nunca subas .env a Git.

# --- LLM (Gemini, capa gratuita) ---
GEMINI_API_KEY=
# Modelo usado antes en pruebas. Verifica en Google AI Studio que siga disponible en la capa gratuita.
GEMINI_MODEL=gemini-2.5-flash

# --- OCI Object Storage (SDK de Python, usado por la aplicación) ---
OCI_CONFIG_FILE=~/.oci/config
OCI_CONFIG_PROFILE=DEFAULT
OCI_REGION=sa-santiago-1
# El namespace no es secreto, pero es propio de cada tenancy: pon el tuyo.
OCI_NAMESPACE=
OCI_BUCKET=communitylab-activos-marketing
