# Normalización automática de saltos de línea para Git (compatibilidad Windows / Linux / OCI)
* text=auto

# Archivos de código y configuración siempre con terminación LF en el repositorio
*.py text eol=lf
*.json text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.css text eol=lf
*.html text eol=lf
*.gitignore text eol=lf
*.gitattributes text eol=lf

# Archivos binarios intactos
*.png binary
*.jpg binary
*.jpeg binary
*.pdf binary
*.ico binary
